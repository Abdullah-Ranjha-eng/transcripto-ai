# App
PORT=5000
NODE_ENV=DEVELOPMENT

# MongoDB
# Used when NODE_ENV=DEVELOPMENT
DB_LOCAL_URI=mongodb://localhost:27017/transcripto-ai
# Used when NODE_ENV is anything else (e.g. PRODUCTION) - your MongoDB Atlas URI
DB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (not currently used in code, kept for future use)
OPENAI_API_KEY=

# Hugging Face (not currently used in code, kept for future use)
HUGGINGFACE_API_KEY=

# Groq (used for captioning/translation)
GROQ_API_KEY=